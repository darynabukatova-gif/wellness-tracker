{
  "name": "wellness-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Wellness Tracker desktop application",
  "main": "electron/main.js",
  "desktopName": "wellness-tracker",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js",
    "dist": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.64.0"
  },
  "build": {
    "appId": "com.wellnesstracker.desktop",
    "productName": "Wellness Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles/**/*",
      "js/**/*",
      "electron/**/*",
      "assets/wellness-tracker-512.png",
      "package.json"
    ],
    "linux": {
      "icon": "assets/wellness-tracker-512.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  }
}
